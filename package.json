{
  "name": "lunatix-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build:web": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist-server/index.mjs",
    "build": "npm run build:web && npm run build:server",
    "preview": "node dist-server/index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@catppuccin/tailwindcss": "^1.0.0",
    "h3": "^1.15.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2",
    "rehype-stringify": "^10.0.1",
    "uniorg-parse": "^3.2.2",
    "uniorg-rehype": "^2.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  }
}
